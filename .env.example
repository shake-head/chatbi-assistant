# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Storage
DATA_DIR=./var
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Authentication
# Replace this value before any non-local deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=chatbi-api
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dataset limits
MAX_UPLOAD_SIZE_MB=50
MAX_DATASET_ROWS=1000000
MAX_HISTORY_MESSAGES=10

# Hosted model provider
# auto: use hosted provider when configured, otherwise local rules in development.
# openai_compatible: require hosted provider. local: development/test only.
AI_PROVIDER=auto
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_MONTHLY_BUDGET_USD=5

# Analysis sandbox
# Memory limit is additional headroom above the Pandas/PyArrow process baseline.
ANALYSIS_TIMEOUT_SECONDS=15
ANALYSIS_MEMORY_LIMIT_MB=1024
ANALYSIS_MAX_RESULT_ROWS=1000

# Docker image override for restricted networks
# PYTHON_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/python:3.11-slim

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_REQUESTS=30
UPLOAD_RATE_LIMIT_REQUESTS=10
